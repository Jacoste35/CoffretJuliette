# ---------------------------------------------------------------------------
# Comptoir des Chatonniers — variables d'environnement
# Copiez ce fichier en .env.local pour le développement, et reportez les mêmes
# clés dans les variables d'environnement du projet Vercel pour la production.
# Aucune de ces valeurs ne doit être commitée.
# ---------------------------------------------------------------------------

# Base de données. IMPORTANT : pointez sur le POOLER Supabase en mode
# transaction (port 6543), pas sur la connexion directe (port 5432). En
# serverless, la connexion directe sature PostgreSQL.
DATABASE_URL="postgresql://postgres.<ref>:<motdepasse>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"

# Supabase — clés publiques, exposées au navigateur, protégées par RLS.
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Clé de service : serveur uniquement. Ne jamais préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""

# Stripe. Le mode test suffit pour démarrer.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Resend. Le domaine doit être authentifié (SPF/DKIM), sans quoi les devis
# partent en spam. Une adresse .vercel.app ne peut pas l'être.
RESEND_API_KEY=""
EMAIL_EXPEDITEUR="devis@example.fr"
